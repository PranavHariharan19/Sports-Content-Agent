# Environment Configuration for Sports Shorts Command Center

# LLM API Keys (Free Tiers)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local Ollama URL (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
CONFIG_PATH=config/config.yaml
SOURCES_CONFIG_PATH=config/sources.yaml
DATABASE_PATH=data/sports_shorts.db
